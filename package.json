{
  "name": "recce",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w recce-backend\" \"npm run dev -w recce-frontend\"",
    "build": "npm run build -w recce-frontend",
    "db:reset": "npm run db:reset -w recce-backend",
    "db:view": "npm run db:view -w recce-backend",
    "db:prune": "npm run db:prune -w recce-backend --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
